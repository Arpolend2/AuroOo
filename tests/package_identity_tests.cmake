if(NOT PACKAGE_ID STREQUAL "ru.arpolend.AuroOo")
    message(FATAL_ERROR "Unexpected package ID: ${PACKAGE_ID}")
endif()

function(require_text file expected)
    file(READ "${file}" contents)
    string(FIND "${contents}" "${expected}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "${file} is missing: ${expected}")
    endif()
endfunction()

set(desktop "${SOURCE_DIR}/${PACKAGE_ID}.desktop")
set(spec "${SOURCE_DIR}/rpm/${PACKAGE_ID}.spec")
require_text("${spec}" "Name:       ${PACKAGE_ID}\n")
require_text("${spec}" "Version:    ${PACKAGE_VERSION}\n")
require_text("${desktop}" "Icon=${PACKAGE_ID}\n")
require_text("${desktop}" "Exec=/usr/bin/${PACKAGE_ID}\n")
require_text("${desktop}" "OrganizationName=ru.arpolend\n")
require_text("${desktop}" "ApplicationName=AuroOo\n")
require_text("${desktop}" "[X-Task NextcloudSync]")
require_text("${SOURCE_DIR}/src/main.cpp" "setOrganizationName(QStringLiteral(\"ru.arpolend\"))")
require_text("${SOURCE_DIR}/src/main.cpp" "setApplicationName(QStringLiteral(\"AuroOo\"))")
require_text("${BINARY_DIR}/QtCreatorDeployment.txt" "${BINARY_DIR}/${PACKAGE_ID}:bin")

if(NOT EXISTS "${BINARY_DIR}/${PACKAGE_ID}")
    message(FATAL_ERROR "Missing package executable: ${PACKAGE_ID}")
endif()
foreach(size 86 108 128 172)
    if(NOT EXISTS "${SOURCE_DIR}/icons/hicolor/${size}x${size}/apps/${PACKAGE_ID}.png")
        message(FATAL_ERROR "Missing ${size}x${size} launcher icon")
    endif()
endforeach()
